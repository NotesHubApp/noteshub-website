---
import { COMPARISON, DISCOUNTS, type FeatureStatus } from '@/data/features';
import Hint from '@/components/Hint.astro';
import Icon from '@/components/Icon.astro';
import StoreLink from '@/components/StoreLink.astro';

const onSale = (store: boolean) => Boolean(DISCOUNTS.amount && store);
const statuses = (feature: (typeof COMPARISON)[number]): FeatureStatus[] => [
  feature.web,
  feature.iOS,
  feature.android,
  feature.windows,
];
---

<div id="feature-comparison" class="home-section">
  <h2 class="home-section-title">Feature Comparison</h2>

  <div class="table-wrap">
    <table class="comparison">
      <thead>
        <tr>
          <th>Included Features</th>
          <th>
            <StoreLink class="platform-link" store="web" placement="comparison">Web</StoreLink>
          </th>
          <th>
            <div class="column-caption">
              <StoreLink class="platform-link" store="app-store" placement="comparison">iOS / macOS</StoreLink>
              {
                onSale(DISCOUNTS.forAppStore) ? (
                  <Icon name="Sale" class="badge" title="Sale" />
                ) : (
                  <Icon name="Recommended" class="badge" title="Recommended" />
                )
              }
            </div>
          </th>
          <th>
            <div class="column-caption">
              <StoreLink class="platform-link" store="google-play" placement="comparison">Android</StoreLink>
              {
                onSale(DISCOUNTS.forPlayStore) ? (
                  <Icon name="Sale" class="badge" title="Sale" />
                ) : (
                  <Icon name="Recommended" class="badge" title="Recommended" />
                )
              }
            </div>
          </th>
          <th>
            <div class="column-caption">
              <StoreLink class="platform-link" store="windows" placement="comparison">Windows</StoreLink>
              /
              <StoreLink class="platform-link" store="linux" placement="comparison">Linux</StoreLink>
              {
                onSale(DISCOUNTS.forWindowsStore) ? (
                  <Icon name="Sale" class="badge" title="Sale" />
                ) : (
                  <Icon name="Recommended" class="badge" title="Recommended" />
                )
              }
            </div>
          </th>
        </tr>
      </thead>

      <tbody>
        {
          COMPARISON.map((feature, index) => (
            <tr class:list={[index % 2 === 0 && 'alternate-row']}>
              <th>
                <div class="feature-name">
                  <span>{feature.name}</span>
                  {feature.hint && <Hint text={feature.hint} />}
                </div>
              </th>
              {statuses(feature).map((status) => (
                <td>
                  {status === 'present' ? (
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="var(--theme-color)" class="status" viewBox="0 0 16 16" role="img" aria-label="Included">
                      <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
                    </svg>
                  ) : (
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#d0d0d0" class="status" viewBox="0 0 16 16" role="img" aria-label="Not included">
                      <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM5.354 4.646a.5.5 0 1 0-.708.708L7.293 8l-2.647 2.646a.5.5 0 0 0 .708.708L8 8.707l2.646 2.647a.5.5 0 0 0 .708-.708L8.707 8l2.647-2.646a.5.5 0 0 0-.708-.708L8 7.293 5.354 4.646z" />
                    </svg>
                  )}
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>

<style>
  .table-wrap {
    max-width: 100%;
    overflow-x: auto;
    word-break: initial;
    white-space: nowrap;
  }

  .comparison {
    border-collapse: collapse;
    width: 100%;
  }

  .comparison thead tr th:first-child {
    text-align: left;
  }

  .comparison tr th {
    padding: 20px;
  }

  .comparison tbody tr th {
    padding: 20px;
    text-align: left;
    font-weight: normal;
  }

  .comparison tr th {
    min-width: 100px;
  }

  .column-caption {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 7px;
  }

  .alternate-row {
    background-color: var(--alternative-raw-color);
  }

  .comparison :global(.platform-link) {
    text-decoration: underline;
  }

  .comparison :global(.platform-link:hover) {
    text-decoration: none;
  }

  .feature-name {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .feature-name :global(svg) {
    flex-shrink: 0;
  }

  .status {
    width: 1.5em;
    height: 1.5em;
  }

  .comparison :global(.badge) {
    width: 35px;
    height: 35px;
    fill: var(--text-primary);
  }
</style>
